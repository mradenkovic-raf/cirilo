<div class="story-prompt"><span class="story-prompt-icon" aria-hidden="true">📖</span><% if exercise['story_context'].present? %><p class="story-context"><%= exercise['story_context'] %></p><% end %><div class="story-sentence"><%= exercise.fetch('story_sentence') %></div></div>
<div class="story-choices" role="group" aria-label="Изабери слику која одговара причи"><% exercise.fetch('choices').each_with_index do |choice, index| %><button type="button" class="choice story-choice" data-answer="<%= choice.fetch('value') %>" aria-label="Слика <%= index + 1 %>"><%= story_scene_svg(choice.fetch('scene')) %><span class="story-choice-number" aria-hidden="true"><%= index + 1 %></span></button><% end %></div>
